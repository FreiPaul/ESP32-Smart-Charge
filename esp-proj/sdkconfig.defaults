# Enable Bluetooth
CONFIG_BT_ENABLED=y

# Use Bluedroid stack
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n

# BLE only mode (ESP32-C6 doesn't support classic BT)
CONFIG_BT_CONTROLLER_ONLY_BT_LE=y

# BLE 4.2 features for broader iOS compatibility
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# Increase main task stack size for BLE operations
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
